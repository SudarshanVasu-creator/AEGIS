# AEGIS environment configuration example
#
# Copy this file to .env and set values as needed.
# .env is excluded from Git — never commit it.
#
# All settings are OPTIONAL.  AEGIS works without any environment variables.

# Default directory for report output.
# When set, you can omit --output from the CLI and AEGIS will write reports here.
# Must be an absolute path.  Leave unset to require --output on every run.
#
# AEGIS_REPORT_DIR=/home/user/aegis-reports
